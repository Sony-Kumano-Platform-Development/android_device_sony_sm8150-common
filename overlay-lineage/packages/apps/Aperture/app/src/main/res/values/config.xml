<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Enable auxiliary cameras selector. -->
    <bool name="config_enableAuxCameras">true</bool>

    <!-- List of ID of auxiliary cameras that must be ignored by the app. -->
    <string-array name="config_ignoredAuxCameraIds">
        <item>2</item>
    </string-array>

    <!-- Sony HAL uses a private boolean distortion-correction request. -->
    <bool name="config_enableSonyDistortionCorrection">true</bool>

    <string-array name="config_sonyDistortionCorrectionCameraIds">
        <item>0</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>

</resources>
